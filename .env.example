# ============================================================
# VIT ELECTRONICS E-Commerce Platform — Environment Variables Template
# Copy this file to .env at project root (for Docker Compose)
# or into backend/.env and frontend/.env.local (for local dev)
# ============================================================

# ── Database & Cache (AWS RDS PostgreSQL & Redis) ────────────
# When using AWS RDS: postgresql://postgres:VitElectronics2026!@<RDS_ENDPOINT>/vitelectronics?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitelectronics?schema=public"
REDIS_URL="redis://redis:6379"

# ── Authentication ───────────────────────────────────────────
JWT_SECRET="change-me-min-32-chars-long-secret"
JWT_REFRESH_SECRET="change-me-different-refresh-secret"
NEXTAUTH_SECRET="change-me-min-32-chars-long-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── AWS Services (S3, CloudFront, SQS, SNS) ───────────────────
AWS_REGION="us-east-1"
AWS_S3_BUCKET="vitelectronics-media"
AWS_CLOUDFRONT_DOMAIN=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SQS_ORDER_QUEUE_URL=""
AWS_SNS_TOPIC_ARN=""

# ── Amazon OpenSearch / Elasticsearch (Optional) ──────────────
AWS_OPENSEARCH_ENDPOINT=""
AWS_OPENSEARCH_USERNAME=""
AWS_OPENSEARCH_PASSWORD=""

# ── App Endpoints & CDN ───────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
INTERNAL_API_URL="http://backend:3001"
NEXT_PUBLIC_CDN_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Email Service (SMTP) ──────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VIT ELECTRONICS <admin@vitelectronics.com>"

# ── Payments (WhatsApp Concierge / COD) ───────────────────────
# Orders placed via VIT Electronics WhatsApp concierge or Pay on Delivery

# ── Monitoring & Admin ────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
ADMIN_EMAIL="admin@vitelectronics.com"
ADMIN_PASSWORD="Admin@123"