{
  "name": "vit-electronics-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "postinstall": "prisma generate",
    "build": "nest build",
    "start:prod": "prisma migrate deploy && node dist/src/main",
    "start:dev": "nest start --watch"
  },
  "prisma": {
    "seed": "node -e \"try{require('./dist/prisma/seed.js')}catch{require('ts-node/register');require('./prisma/seed.ts')}\""
  },
  "overrides": {
    "multer": "^2.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sns": "^3.1136.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@aws-sdk/client-ssm": "^3.1136.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/throttler": "^6.5.0",
    "@opensearch-project/opensearch": "^3.6.0",
    "@prisma/client": "^5.15.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/node": "^10.57.0",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.6.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto": "^1.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prisma": "^5.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
